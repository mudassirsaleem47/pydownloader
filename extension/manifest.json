{
  "manifest_version": 3,
  "name": "YouTubeDownloader",
  "version": "1.2",
  "author": "mudassir developer",
  "description": "Download YouTube videos directly using YouTubeDownloader.",
  "permissions": [
    "activeTab"
  ],
  "host_permissions": [
    "http://127.0.0.1:30121/*",
    "https://*.youtube.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_icon": "icon.png"
  },
  "icons": {
    "48": "icon.png"
  }
}